# E-Commerce Platform Environment Variables
# Copy this file to .env and update with your values

# ============================================
# INFRASTRUCTURE
# ============================================

# PostgreSQL
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=dev123456
POSTGRES_DB=ecommerce

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=dev123456

# Redis
REDIS_PASSWORD=dev123456

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=dev123456

# ============================================
# KEYCLOAK (OAuth/OIDC)
# ============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_DATABASE_VENDOR=postgres
KEYCLOAK_DATABASE_HOST=keycloak-db
KEYCLOAK_DATABASE_PORT=5432
KEYCLOAK_DATABASE_NAME=keycloak
KEYCLOAK_DATABASE_USER=keycloak
KEYCLOAK_DATABASE_PASSWORD=keycloak123

# ============================================
# KONG API GATEWAY
# ============================================
KONG_DATABASE=postgres
KONG_PG_HOST=kong-db
KONG_PG_PORT=5432
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong123

# ============================================
# PAYMENT GATEWAYS (Sandbox/Test Keys)
# ============================================

# Stripe
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# PayPal
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_MODE=sandbox

# Adyen
ADYEN_API_KEY=YOUR_ADYEN_TEST_API_KEY
ADYEN_MERCHANT_ACCOUNT=YOUR_MERCHANT_ACCOUNT
ADYEN_ENVIRONMENT=test

# ============================================
# NOTIFICATION SERVICES
# ============================================

# SendGrid
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
FROM_EMAIL=noreply@ecommerce.local

# ============================================
# OBSERVABILITY
# ============================================

# Jaeger
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# JWT Settings
JWT_SECRET_KEY=your-256-bit-secret-key-change-this-in-production
JWT_ISSUER=ecommerce-platform
JWT_AUDIENCE=ecommerce-api
JWT_EXPIRATION_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# SERVICE PORTS
# ============================================
PRODUCT_SERVICE_PORT=8001
INVENTORY_SERVICE_PORT=8002
CART_SERVICE_PORT=8003
ORDER_SERVICE_PORT=8004
PAYMENT_SERVICE_PORT=8005
USER_SERVICE_PORT=8006
SHIPPING_SERVICE_PORT=8007
NOTIFICATION_SERVICE_PORT=8008
SEARCH_SERVICE_PORT=8009
REVIEW_SERVICE_PORT=8010
RECOMMENDATION_SERVICE_PORT=8011
ANALYTICS_SERVICE_PORT=8012
FRAUD_SERVICE_PORT=8013
IMAGE_SERVICE_PORT=8014
WAREHOUSE_SERVICE_PORT=8015

# ============================================
# FRONTEND
# ============================================
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ecommerce
VITE_KEYCLOAK_CLIENT_ID=web-app

# ============================================
# STORAGE
# ============================================

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ecommerce-images
